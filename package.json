{
  "name": "charadock",
  "version": "0.1.0",
  "description": "CharaDock is a transparent Windows desktop companion powered by PuruPuru PNGTuber, Codex app-server, and the OpenAI Responses API.",
  "main": "desktop/main.cjs",
  "author": "ochisamu",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "desktop": "electron .",
    "desktop:debug": "electron . --debug",
    "previews:build": "node scripts/build_character_previews.cjs",
    "site:build": "node scripts/build_character_previews.cjs && node scripts/build_site.mjs",
    "assets:clean-alpha": "node scripts/clean_avatar_alpha.cjs assets/amber-avatar assets/bronze-avatar assets/towa-avatar assets/sage-avatar",
    "test:desktop": "node --test desktop/tests/*.test.cjs",
    "test": "node tests/js_runtime_checks.mjs && npm run test:desktop && uv run python -m unittest tests.test_project_static",
    "dist": "electron-builder --dir",
    "dist:win": "electron-builder --win --dir",
    "dist:win:installer": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "jp.ochisamu.charadock.desktop",
    "productName": "CharaDock",
    "copyright": "Copyright © 2026 ochisamu",
    "asar": true,
    "files": [
      "app.js",
      "motion-runtime.js",
      "index.html",
      "styles.css",
      "app-icon.ico",
      "assets/amber-avatar/**/*",
      "assets/bronze-avatar/**/*",
      "assets/towa-avatar/**/*",
      "assets/sage-avatar/**/*",
      "vendor/**/*",
      "desktop/**/*",
      ".agents/skills/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "MODIFICATIONS.md",
      "DISTRIBUTION_ASSET_LICENSE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**/*",
      "node_modules/onnxruntime-web/dist/**/*",
      "node_modules/piper-plus/dist/**/*.wasm"
    ],
    "win": {
      "icon": "app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "budoux": "0.7.0",
    "cmu-pronouncing-dictionary": "3.0.0",
    "onnxruntime-web": "1.27.0",
    "piper-plus": "0.6.0",
    "pngjs": "^7.0.0",
    "sherpa-onnx-node": "^1.13.4"
  }
}
